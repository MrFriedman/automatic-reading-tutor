# Front-end demo (Vercel): leave both unset. Demo mode turns on when no API URL is set.
# REACT_APP_DEMO_MODE=true

# Real Flask backend. Setting this URL turns demo mode off unless REACT_APP_DEMO_MODE=true.
# REACT_APP_API_URL=http://localhost:5000

# Local `npm start` against the CRA proxy (package.json "proxy") without calling Flask by URL:
# REACT_APP_DEMO_MODE=false
